generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  CUSTODIAN
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement()) @map("user_id")
  username  String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentProfile StudentProfile?
  schedules      Schedule[]

  @@map("users")
}

model StudentProfile {
  id            Int      @id @default(autoincrement()) @map("student_profile_id")
  userId        Int      @unique @map("user_id")
  studentNumber String   @unique @map("student_number")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  course        String?
  yearLevel     Int?     @map("year_level")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceLogs   AttendanceLog[]
  classEnrollments ClassEnrollment[]
  pcOccupancies    PcOccupancy[]
  pcIssueReports   PcIssueReport[]

  @@map("student_profiles")
}

model LabRoom {
  id          Int      @id @default(autoincrement()) @map("lab_room_id")
  roomName    String   @map("room_name")
  capacity    Int?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  schedules Schedule[]

  @@map("lab_rooms")
}

model Schedule {
  id           Int      @id @default(autoincrement()) @map("schedule_id")
  instructorId Int      @map("instructor_id")
  labRoomId    Int      @map("lab_room_id")
  subjectCode  String   @map("subject_code")
  dayOfWeek    String   @map("day_of_week")
  startTime    DateTime @map("start_time")
  endTime      DateTime @map("end_time")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  instructor       User              @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  labRoom          LabRoom           @relation(fields: [labRoomId], references: [id], onDelete: Cascade)
  classEnrollments ClassEnrollment[]
  activeSessions   ActiveSession[]

  @@map("schedules")
}

model ClassEnrollment {
  id               Int      @id @default(autoincrement()) @map("class_enrollment_id")
  studentProfileId Int      @map("student_profile_id")
  scheduleId       Int      @map("schedule_id")
  enrolledAt       DateTime @default(now()) @map("enrolled_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  schedule       Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("class_enrollment")
}

model ActiveSession {
  id          Int       @id @default(autoincrement()) @map("active_session_id")
  scheduleId  Int       @map("schedule_id")
  sessionDate DateTime  @default(now()) @map("session_date")
  startTime   DateTime  @default(now()) @map("start_time")
  endTime     DateTime? @map("end_time")
  status      String    @default("ACTIVE")

  schedule       Schedule        @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]
  pcOccupancies  PcOccupancy[]
  pcIssueReports PcIssueReport[]

  @@map("active_session")
}

model AttendanceLog {
  id               Int       @id @default(autoincrement()) @map("attendance_log_id")
  studentProfileId Int       @map("student_profile_id")
  activeSessionId  Int       @map("active_session_id")
  timeIn           DateTime  @default(now()) @map("time_in")
  timeOut          DateTime? @map("time_out")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  activeSession  ActiveSession  @relation(fields: [activeSessionId], references: [id], onDelete: Cascade)

  @@map("attendance_log")
}

model PcOccupancy {
  id               Int       @id @default(autoincrement()) @map("pc_occupancy_id")
  activeSessionId  Int       @map("active_session_id")
  studentProfileId Int       @map("student_profile_id")
  pcNumber         String    @map("pc_number")
  timeClaimed      DateTime  @default(now()) @map("time_claimed")
  timeReleased     DateTime? @map("time_released")

  activeSession  ActiveSession  @relation(fields: [activeSessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("pc_occupancy")
}

model PcIssueReport {
  id               Int      @id @default(autoincrement()) @map("pc_issue_report_id")
  activeSessionId  Int      @map("active_session_id")
  studentProfileId Int      @map("student_profile_id")
  pcNumber         String   @map("pc_number")
  issueDescription String   @map("issue_description") @db.Text
  status           String   @default("PENDING")
  reportedAt       DateTime @default(now()) @map("reported_at")

  activeSession  ActiveSession  @relation(fields: [activeSessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("pc_issue_report")
}
