DATABASE_URL="mysql://username:password@localhost:3306/clams"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
CORS_ORIGINS="http://localhost"
TRUST_PROXY_HOPS=1
APP_TIME_ZONE="Asia/Manila"
SCHEDULE_EARLY_GRACE_MIN=15

# ---- Production (used by docker-compose.yml on the VPS) ----
DOMAIN=localhost
DB_PASSWORD=localdevpass
# Same password, but with URL-special chars encoded.
# @ becomes %40, # becomes %23, : becomes %3A, / becomes %2F
DB_PASSWORD_URLENCODED=localdevpass
DB_ROOT_PASSWORD=localrootpass
